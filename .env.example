# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (Client-side Maps JS, 3D Maps, Places, Routes)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# PostgreSQL Configuration (Untuk migrasi ke server CasaOS + Docker)
PGHOST="localhost"
PGPORT="5432"
PGUSER="tanggamus_admin"
PGPASSWORD="change_me_strong_password"
PGDATABASE="tanggamus_webgis"

# Admin Dashboard Passcode (Opsional: jika kosong, gunakan setup awal di UI Admin)
ADMIN_PASSCODE=""
